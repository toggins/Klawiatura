<body>
    <div id="container">
        <div id="error" style="display: none;">
            <b>Game crashed!</b><br>
            Check console for more details.
        </div>

        <canvas id="canvas" width="640" height="480" oncontextmenu="event.preventDefault()"></canvas>

        <script type="text/javascript">
            var Module = {
                canvas: document.getElementById("canvas"),
                locateFile: function (path, scriptDirectory) {
                    if (path.endsWith(".wasm")) {
                        return scriptDirectory + "Klawiatura.wasm{{ nocache }}";
                    } else {
                        return scriptDirectory + path;
                    }
                },
                onAbort: function (what) {
                    document.getElementById("error").style.display = "block";

                    var canvas = document.getElementById("canvas");
                    canvas.style.opacity = 0.5;
                    canvas.style.backgroundImage = "none";
                }
            };
        </script>

        <script async src="/Klawiatura.js{{ nocache }}"></script>

        <footer>
            Want custom content?
            <a href="https://github.com/toggins/Klawiatura/releases/latest">Play the desktop build</a>!
            <br>
            <a href="#" id="download-user-folder">Download User Folder</a> &bull;
            <a href="https://github.com/toggins/Klawiatura">Source Code</a> &bull;
            <a href="https://github.com/toggins/Klawiatura#attribution">Attribution</a>
        </footer>
    </div>
</body>

</html>
